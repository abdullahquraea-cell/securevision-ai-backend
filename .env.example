# ===========================================
# SecureVision AI - Environment Variables (Example)
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية
# NEVER commit your real .env file
# ===========================================

# --- Database ---
# PostgreSQL على الإنتاج، SQLite للتطوير المحلي
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/securevision
# أو للترقية المحلية: DATABASE_URL=sqlite:///./securevision.db

# --- Security ---
# مفتاح JWT — استخدم نصاً عشوائياً طويلاً (مثلاً 64 حرفاً)
# يمكنك توليده بـ: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-long-random-string

# --- AI ---
# مفتاح Anthropic (Claude AI) لتحليل الثغرات
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- CORS / Frontend ---
# النطاقات المسموح لها بالاتصال (مفصولة بفواصل)
ALLOWED_ORIGINS=https://your-domain.com,https://securevision-ai-gamma.vercel.app
FRONTEND_URL=https://your-domain.com

# --- Email (اختياري) ---
# تفعيل إرسال البريد (true/false)
EMAIL_ENABLED=false

# خيار 1: Brevo HTTP API (يُفضّل للإنتاج — منفذ 443)
BREVO_API_KEY=
SMTP_FROM=noreply@your-domain.com

# خيار 2: SMTP (للتطوير المحلي)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Stripe (اختياري — للاشتراكات) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Firebase Admin SDK (مطلوب للتحقق من Firebase ID Tokens على الباك-إند) ---
# احصل عليه من Firebase Console → Project Settings → Service Accounts → Generate new private key
# ثم انسخ محتوى JSON بالكامل (مكتوب على سطر واحد أو متعدد الأسطر)
FIREBASE_CREDENTIALS={"type":"service_account","project_id":"vision-ai-94a5a",...}

# --- Vercel Deployment ---
# تُضاف تلقائياً على Vercel — لا تضعها هنا
# VERCEL=1
# VERCEL_ENV=production
# NEXT_PUBLIC_VERCEL_URL=...
